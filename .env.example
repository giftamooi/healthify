# Salin ke .env lalu isi. File .env JANGAN di-commit.

# Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-panjang

# API key untuk kelompok lain, pisahkan dengan koma (satu key per kelompok).
# Buat dengan: openssl rand -hex 16
API_KEYS=key-kelompok-a,key-kelompok-b

DB_PATH=/data/Healthify.db

# Isi nanti, saat setup Cloudflare Tunnel (di STB). Kosongkan di laptop.
TUNNEL_TOKEN=
# Di STB, aktifkan tunnel otomatis dengan menghapus tanda # di baris berikut:
# COMPOSE_PROFILES=tunnel
